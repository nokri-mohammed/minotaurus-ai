{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brain-config.schema.json",
  "title": "minotaurus training config",
  "type": "object",
  "required": ["name", "method", "levels", "episodes", "seed"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"},
    "method": {"enum": ["qtable", "dqn"]},
    "levels": {
      "oneOf": [
        {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "level ids"},
        {
          "type": "object",
          "required": ["difficulty"],
          "additionalProperties": false,
          "properties": {"difficulty": {"enum": ["easy", "medium", "hard"]}}
        }
      ]
    },
    "episodes": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": {"const": 5, "description": "Reserved: only 5 is supported yet"}
      }
    },
    "qtable": {
      "type": "object",
      "required": ["learning_rate", "gamma", "epsilon_start", "epsilon_end", "epsilon_decay"],
      "additionalProperties": false,
      "properties": {
        "learning_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "gamma": {"type": "number", "minimum": 0, "maximum": 1},
        "epsilon_start": {"type": "number", "minimum": 0, "maximum": 1},
        "epsilon_end": {"type": "number", "minimum": 0, "maximum": 1},
        "epsilon_decay": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "dqn": {
      "type": "object",
      "required": [
        "hidden_layers", "learning_rate", "batch_size", "gamma", "replay_size",
        "target_update", "epsilon_start", "epsilon_end", "epsilon_decay"
      ],
      "additionalProperties": false,
      "properties": {
        "hidden_layers": {
          "type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}
        },
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "batch_size": {"type": "integer", "minimum": 1},
        "gamma": {"type": "number", "minimum": 0, "maximum": 1},
        "replay_size": {"type": "integer", "minimum": 1},
        "target_update": {"type": "integer", "minimum": 1},
        "epsilon_start": {"type": "number", "minimum": 0, "maximum": 1},
        "epsilon_end": {"type": "number", "minimum": 0, "maximum": 1},
        "epsilon_decay": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "memory": {"const": 0, "description": "Reserved: memory networks are not supported yet"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"method": {"const": "qtable"}}}, "then": {"required": ["qtable"]}},
    {"if": {"properties": {"method": {"const": "dqn"}}}, "then": {"required": ["dqn"]}}
  ]
}
