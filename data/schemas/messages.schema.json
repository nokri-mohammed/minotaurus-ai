{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "messages.schema.json",
  "title": "minotaurus arena messages (server to page) and HTTP bodies",
  "description": "The contract between the game server and the page. WS /ws/run?level_id=<id> sends the run messages; GET /api/levels and POST /api/brain return the other two bodies.",
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "run_started": {
      "type": "object",
      "required": [
        "type",
        "level_id",
        "start",
        "step_limit"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "run_started"
        },
        "level_id": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "step_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tick": {
      "type": "object",
      "required": [
        "type",
        "n",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tick"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "type",
        "status",
        "steps",
        "seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "result"
        },
        "status": {
          "enum": [
            "finished",
            "timed_out",
            "stuck",
            "error"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "path_ratio": {
          "type": "number",
          "minimum": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "run_message": {
      "oneOf": [
        {
          "$ref": "#/$defs/run_started"
        },
        {
          "$ref": "#/$defs/tick"
        },
        {
          "$ref": "#/$defs/result"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "level_info": {
      "type": "object",
      "required": [
        "id",
        "name",
        "difficulty",
        "grid",
        "step_limit"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard",
            "impossible"
          ]
        },
        "group": {
          "enum": [
            "hand-made",
            "test"
          ]
        },
        "grid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[#.SE]+$"
          }
        },
        "step_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "levels_response": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/level_info"
      }
    },
    "brain_response": {
      "type": "object",
      "required": [
        "id",
        "name",
        "method",
        "has_recipe",
        "added_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "type": "string"
        },
        "method": {
          "enum": [
            "qtable",
            "dqn"
          ]
        },
        "has_recipe": {
          "type": "boolean"
        },
        "added_at": {
          "type": "string"
        }
      }
    },
    "brains_response": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/brain_response"
      }
    },
    "brain_recipe": {
      "type": "object",
      "required": [
        "bundle_version",
        "config",
        "has_graph"
      ],
      "additionalProperties": false,
      "properties": {
        "bundle_version": {
          "type": "integer",
          "minimum": 1
        },
        "config": {
          "type": "object"
        },
        "scores": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "train",
                "validation",
                "test"
              ],
              "additionalProperties": false,
              "properties": {
                "train": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "validation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "test": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "fixed_levels": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            }
          ]
        },
        "test_stats": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "avg_steps"
              ],
              "additionalProperties": false,
              "properties": {
                "avg_steps": {
                  "type": "number",
                  "minimum": 0
                },
                "avg_path_ratio": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 1
                    }
                  ]
                }
              }
            }
          ]
        },
        "has_graph": {
          "type": "boolean"
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": [
        "id",
        "date",
        "brain_id",
        "brain",
        "method",
        "level",
        "result",
        "steps",
        "seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "date": {
          "type": "string"
        },
        "brain_id": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|unknown)$"
        },
        "brain": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "result": {
          "enum": [
            "finished",
            "timed_out",
            "stuck",
            "error",
            "stopped"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      }
    },
    "attempts_response": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "level_result": {
      "type": "object",
      "required": [
        "level_id",
        "name",
        "group",
        "status",
        "steps",
        "seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "level_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "group": {
          "enum": [
            "hand-made",
            "test"
          ]
        },
        "status": {
          "enum": [
            "finished",
            "timed_out",
            "stuck",
            "error"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "path_ratio": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "batch_result": {
      "type": "object",
      "required": [
        "id",
        "brain_id",
        "date",
        "total",
        "finished",
        "results"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "brain_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "date": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "finished": {
          "type": "integer",
          "minimum": 0
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level_result"
          }
        }
      }
    },
    "batches_response": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/batch_result"
      }
    }
  }
}
