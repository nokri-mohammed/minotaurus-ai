{
  "$defs": {
    "DQNSettings": {
      "additionalProperties": false,
      "properties": {
        "hidden_layers": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Hidden Layers",
          "type": "array"
        },
        "learning_rate": {
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "batch_size": {
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "gamma": {
          "maximum": 1,
          "minimum": 0,
          "title": "Gamma",
          "type": "number"
        },
        "replay_size": {
          "minimum": 1,
          "title": "Replay Size",
          "type": "integer"
        },
        "target_update": {
          "minimum": 1,
          "title": "Target Update",
          "type": "integer"
        },
        "epsilon_start": {
          "maximum": 1,
          "minimum": 0,
          "title": "Epsilon Start",
          "type": "number"
        },
        "epsilon_end": {
          "maximum": 1,
          "minimum": 0,
          "title": "Epsilon End",
          "type": "number"
        },
        "epsilon_decay": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Epsilon Decay",
          "type": "number"
        },
        "memory": {
          "anyOf": [
            {
              "const": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        }
      },
      "required": [
        "hidden_layers",
        "learning_rate",
        "batch_size",
        "gamma",
        "replay_size",
        "target_update",
        "epsilon_start",
        "epsilon_end",
        "epsilon_decay"
      ],
      "title": "DQNSettings",
      "type": "object"
    },
    "DifficultyLevels": {
      "additionalProperties": false,
      "properties": {
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        }
      },
      "required": [
        "difficulty"
      ],
      "title": "DifficultyLevels",
      "type": "object"
    },
    "GeneratedLevels": {
      "additionalProperties": false,
      "properties": {
        "generated": {
          "$ref": "#/$defs/GeneratedSettings"
        }
      },
      "required": [
        "generated"
      ],
      "title": "GeneratedLevels",
      "type": "object"
    },
    "GeneratedSettings": {
      "additionalProperties": false,
      "properties": {
        "size": {
          "maximum": 41,
          "minimum": 5,
          "title": "Size",
          "type": "integer"
        },
        "maze_seed": {
          "title": "Maze Seed",
          "type": "integer"
        },
        "train": {
          "minimum": 1,
          "title": "Train",
          "type": "integer"
        },
        "validation": {
          "minimum": 1,
          "title": "Validation",
          "type": "integer"
        },
        "test": {
          "minimum": 1,
          "title": "Test",
          "type": "integer"
        }
      },
      "required": [
        "size",
        "maze_seed",
        "train",
        "validation",
        "test"
      ],
      "title": "GeneratedSettings",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "window": {
          "const": 5,
          "default": 5,
          "title": "Window",
          "type": "integer"
        }
      },
      "title": "Observation",
      "type": "object"
    },
    "QTableSettings": {
      "additionalProperties": false,
      "properties": {
        "learning_rate": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Learning Rate",
          "type": "number"
        },
        "gamma": {
          "maximum": 1,
          "minimum": 0,
          "title": "Gamma",
          "type": "number"
        },
        "epsilon_start": {
          "maximum": 1,
          "minimum": 0,
          "title": "Epsilon Start",
          "type": "number"
        },
        "epsilon_end": {
          "maximum": 1,
          "minimum": 0,
          "title": "Epsilon End",
          "type": "number"
        },
        "epsilon_decay": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Epsilon Decay",
          "type": "number"
        }
      },
      "required": [
        "learning_rate",
        "gamma",
        "epsilon_start",
        "epsilon_end",
        "epsilon_decay"
      ],
      "title": "QTableSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$",
      "title": "Name",
      "type": "string"
    },
    "method": {
      "enum": [
        "qtable",
        "dqn"
      ],
      "title": "Method",
      "type": "string"
    },
    "levels": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "$ref": "#/$defs/DifficultyLevels"
        },
        {
          "$ref": "#/$defs/GeneratedLevels"
        }
      ],
      "title": "Levels"
    },
    "episodes": {
      "minimum": 1,
      "title": "Episodes",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "observation": {
      "$ref": "#/$defs/Observation",
      "default": {
        "window": 5
      }
    },
    "qtable": {
      "anyOf": [
        {
          "$ref": "#/$defs/QTableSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dqn": {
      "anyOf": [
        {
          "$ref": "#/$defs/DQNSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "name",
    "method",
    "levels",
    "episodes",
    "seed"
  ],
  "title": "ConfigFile",
  "type": "object"
}
